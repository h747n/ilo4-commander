# ---- the panel ------------------------------------------------------
BIND_HOST=0.0.0.0
BIND_PORT=8080
ILO_DATA_DIR=./data
# Leave empty for no login (trusted LAN only).
UI_PASSWORD=
# How long a login lasts, so the phone app doesn't keep asking.
SESSION_DAYS=30
# Optional HTTPS. Needed for installing the panel as a PWA on phones.
SSL_CERT=
SSL_KEY=

# ---- defaults for new servers (each server can override them) ---------
POLL_SECONDS=10
MIN_PWM_PERCENT=8
WATCHDOG_MARGIN_C=5

# The free-form `fan ...` box on the Tuning tab.
ALLOW_RAW_FAN=true

# iLO addresses and passwords are NOT set here any more. Add servers in the
# panel (gear icon -> + Add server); they're stored in data/servers.json.
